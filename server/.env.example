# Copy this file to .env (never commit .env) and fill in your values.

PORT=5000

# MongoDB Atlas connection string: Atlas > Clusters > Connect > Drivers > Node.js.
# Replace <db_username> and <db_password> with your Database Access user (no < > brackets kept).
# Keep the database name (roots_employee_tasks) between the host and the "?".
# Special characters in the password must be URL-encoded (@ -> %40, # -> %23, / -> %2F).
MONGO_URI=mongodb+srv://bedaderavi03_db_user:8799RavindrA923345@rootsmediacluster.op8txme.mongodb.net/roots_employee_tasks?retryWrites=true&w=majority

# Browser address(es) allowed to call this API, comma-separated.
CLIENT_URL=http://localhost:5173

# Optional: only if you get a "querySrv ECONNREFUSED" / DNS error connecting to Atlas.
# DNS_SERVERS=8.8.8.8,1.1.1.1
